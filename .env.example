# Agent Registry Configuration

# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_PATH=./data/registry.db

# Proof-of-Work difficulty (number of leading zero bits)
POW_DIFFICULTY=20

# Challenge expiry in seconds
CHALLENGE_TTL_SECONDS=300

# Auth: max clock skew in seconds
AUTH_MAX_CLOCK_SKEW=60

# ─── Agent Testing (managed compatibility audits) — ALL OFF by default ───
# Flags are deliberate operator decisions; a missing item disables the
# affected action with useful copy, never a fake success. See
# docs/AGENT_TESTING_RUNBOOK.md for the launch checklist.
TESTING_PRODUCT_ENABLED=false
TESTING_CHECKOUT_ENABLED=false
TESTING_FULFILLMENT_ENABLED=false
TESTING_PRODUCT_LIVE_APPROVED=false
# One-time Stripe Price (test mode until live is approved); must match the
# configured package subtotal exactly.
STRIPE_PRICE_TESTING_AUDIT=
# Dedicated marketplace service principal ("BasedAgents Testing") — a
# registered agent id. Its signing key stays in the platform's secret store.
TESTING_PLATFORM_AGENT_ID=
# SEPARATE worker-payment treasury (secp256k1 hex key) — never the customer's
# money, never the escrow custody wallet's key.
TESTING_TREASURY_PRIVATE_KEY=
# Optional knobs (defaults shown)
TESTING_MAX_ACTIVE_ORDERS=5
TESTING_MAX_WORKER_COMMITMENT_USDC_ATOMIC=30000000
TESTING_EVIDENCE_RETENTION_DAYS=90
TESTING_REPORT_RETENTION_DAYS=365
TESTING_DRAFT_RETENTION_DAYS=30
TESTING_SUPPORT_EMAIL=
# In production TESTING_OPERATOR_EMAIL is a wrangler SECRET (scripts/put-secrets.sh),
# so a personal address never sits in wrangler.toml. Unset = alerts stay in the console queue.
TESTING_OPERATOR_EMAIL=
# Dev only: allow the log-only email sender to satisfy the checkout email
# readiness gate. NEVER set in production.
# TESTING_ALLOW_LOG_EMAIL=1
