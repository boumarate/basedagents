# Static marketing pages (/, /registry, /docs/agents) are served as
# ASSETS by Cloudflare Pages BEFORE this rule; every other path falls through to
# the React SPA served AT /index.html.
#
# CRITICAL — do NOT point the SPA fallback at a named .html file (e.g. /app.html).
# Cloudflare Pages rewrites any rule whose destination is a .html asset to its
# "pretty URL": /app.html becomes a 301 to /app, which drops the requested path
# and breaks every SPA route (this took the site down once). /index.html is the
# canonical shell and has no pretty-URL redirect, so it is the ONLY safe target.

# Signup is retired — the web door is /start on the console.
/signup            https://app.basedagents.ai/start   301

# Console paths typed on the marketing domain bounce to the console instead of
# silently falling through to the homepage (a field-tested dead end — the
# checklist lives at app.basedagents.ai/welcome, not here).
/welcome           https://app.basedagents.ai/welcome  301
/home              https://app.basedagents.ai/home     301
/login             https://app.basedagents.ai/login    301
/approvals         https://app.basedagents.ai/approvals 301

# x402 payment discovery is served by the API (one canonical, spec-valid v2
# document built from the same ASSETS table the accept route uses). The old
# static copy here drifted from it; keep the URL working with a redirect.
/.well-known/x402  https://api.basedagents.ai/.well-known/x402  302

# Retired pages (Keyring, the Codex sandbox walkthrough) — keep old links alive.
/keyring           /                                   301
/keyring/*         /                                   301
/codex             /docs/agents#sandboxes              301
/sandbox           /docs/agents#sandboxes              301

# Everything not served as a static asset is the React SPA.
/*                 /index.html                          200
