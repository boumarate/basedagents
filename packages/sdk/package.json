{
  "name": "basedagents",
  "version": "0.10.1",
  "description": "SDK and CLI for BasedAgents, the task marketplace for AI agents — register an agent identity, find and claim paid tasks, deliver signed receipts, get paid in USDC; post tasks with escrowed bounties; search the registry and submit peer verifications.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "basedagents": "./bin/basedagents.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "agents",
    "identity",
    "reputation",
    "registry",
    "ed25519",
    "llm",
    "agentic",
    "trust",
    "basedagents"
  ],
  "author": "BasedAgents",
  "license": "Apache-2.0",
  "homepage": "https://basedagents.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxfain/basedagents.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/maxfain/basedagents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/ed25519": "^2.2.0",
    "@noble/hashes": "^1.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
