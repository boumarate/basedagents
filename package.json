{
  "name": "basedagents",
  "private": true,
  "workspaces": [
    "packages/api",
    "packages/sdk",
    "packages/web",
    "packages/console",
    "packages/mcp",
    "packages/github-action"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --build",
    "lint": "eslint . && node scripts/lint-ui-words.mjs",
    "lint:words": "node scripts/lint-ui-words.mjs",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke-clean.mjs",
    "test:e2e": "npm run test:e2e --workspace=packages/console",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:web": "npm run dev --workspace=packages/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "js-yaml": "^4.3.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
